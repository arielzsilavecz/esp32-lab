# Copiar a .env y completar. Nunca commitear .env real.

# Cadena de conexion de Postgres (Railway te la da al crear el addon).
DATABASE_URL=postgresql://usuario:password@host:puerto/basededatos

# Clave para firmar las cookies de sesion. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# development | production. En production, las cookies de sesion exigen HTTPS.
NODE_ENV=development

PORT=3000
