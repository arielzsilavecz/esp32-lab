[Unit]
Description=NEO: limitar carga de la bateria al 60 % (vive enchufada)

[Service]
Type=oneshot
RemainAfterExit=yes
# El valor se pierde en cada arranque en esta ASUS; por eso corre al boot.
ExecStart=/bin/sh -c 'echo 60 > /sys/class/power_supply/BAT0/charge_control_end_threshold'

[Install]
WantedBy=multi-user.target
