# Copiar a /etc/neo-camaras/<nombre>.env (root, 640, grupo camaras) y activar
#   sudo systemctl enable --now camara@<nombre>
# La URL sale de ONVIF (GetStreamUri). Si la camara pide clave:
#   rtsp://usuario:clave@IP:554/... -- por eso el archivo no va al repo.
CAM_URL=rtsp://192.168.100.122:554/0/av0
CAM_LIMITE_GB=50
